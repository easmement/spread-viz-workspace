{:deps {:aliases [:dev]}

 :builds
 {:app {:target :browser
        :output-dir "target/public/js"
        :asset-path "/js"
        :modules {:main {:init-fn jotis.viz.dashboard.core/init}}
        
        :devtools {:after-load jotis.viz.dashboard.core/mount-root
                   :http-root "target/public"
                   :http-port 8080}}}}
