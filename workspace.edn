;; Polylith workspace configuration. Each project's bricks are listed in its own
;; projects/<name>/deps.edn; the development project is the root deps.edn (:dev and :test).
{:top-namespace        "jotis.viz"
 :interface-ns         "interface"
 :default-profile-name "default"
 :compact-views        #{}
 :vcs                  {:name "git" :auto-add false}
 :tag-patterns         {:stable "stable-*" :release "v[0-9]*"}
 :projects             {"development"   {:alias "dev"}
                        "dashboard-app" {:alias "app"}}}
