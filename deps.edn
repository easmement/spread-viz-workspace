{:paths ["development/src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  org.clojure/clojurescript {:mvn/version "1.11.132"}

  ;; --- Math & Data Engineering ---
  org.apache.commons/commons-math3 {:mvn/version "3.6.1"}
  cheshire/cheshire {:mvn/version "5.13.0"}
  http-kit/http-kit {:mvn/version "2.8.0"}

  ;; --- Web Server ---
  ring/ring-core {:mvn/version "1.12.1"}
  ring/ring-jetty-adapter {:mvn/version "1.12.1"}
  ring/ring-json {:mvn/version "0.5.1"}
  compojure/compojure {:mvn/version "1.7.1"}

  ;; --- Trade Store ---
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
  org.postgresql/postgresql         {:mvn/version "42.7.4"}
  com.zaxxer/HikariCP               {:mvn/version "5.1.0"}

  ;; --- Frontend ---
  reagent/reagent {:mvn/version "1.2.0"}}

 :aliases
 {:dev
  {:extra-paths ["components/math-engine/src"
                 "components/market-data/src"
                 "components/trading-logic/src"
                 "components/account/src"
                 "components/order-manager/src"
                 "components/trade-store/src"
                 "bases/dashboard/src"]
   :extra-deps {com.bhauman/rebel-readline {:mvn/version "0.1.4"}
                thheller/shadow-cljs {:mvn/version "2.28.20"}}}

  :server
  {:extra-paths ["components/math-engine/src"
                 "components/market-data/src"
                 "components/account/src"
                 "components/order-manager/src"
                 "components/trade-store/src"
                 "bases/dashboard/src"]
   :main-opts ["-m" "jotis.viz.dashboard.server"]}

  :poly
  {:extra-deps {polylith/clj-poly {:mvn/version "0.2.20"}}
   :main-opts ["-m" "polylith.clj.poly.main"]}}}
